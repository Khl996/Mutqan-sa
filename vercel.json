{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/((?!$|about$|contact$|privacy$|terms$|login$|register$|robots\\.txt$|sitemap\\.xml$|images/|icons/|assets/).*)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex"
                }
            ]
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "suf": ".vercel.app"
                    }
                }
            ],
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex"
                }
            ]
        }
    ],
    "crons": [
        {
            "path": "/api/check-subscriptions",
            "schedule": "0 3 * * *"
        },
        {
            "path": "/api/pm-generate-wos",
            "schedule": "0 6 * * *"
        }
    ]
}