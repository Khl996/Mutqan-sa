{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/check-subscriptions",
            "schedule": "0 3 * * *"
        },
        {
            "path": "/api/pm-generate-wos",
            "schedule": "0 6 * * *"
        }
    ]
}